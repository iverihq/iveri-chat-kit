{
  "name": "@iveri/chat-kit",
  "version": "0.5.1",
  "description": "Baasi messenger client for Iveri products: a headless chat client with React hooks, and ready conversation components for React web and React Native",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iverihq/iveri-chat-kit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    },
    "./web-call": {
      "types": "./dist/web-call/index.d.ts",
      "default": "./dist/web-call/index.js"
    },
    "./web.css": "./styles/web.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/verify-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite --config preview/vite.config.ts"
  },
  "prettier": "@iveri/prettier-config",
  "dependencies": {
    "@iveri/tokens": "^0.2.0",
    "intl-messageformat": "^12.1.5",
    "socket.io-client": "^4.8.4"
  },
  "peerDependencies": {
    "@iveri/contracts": ">=0.98.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": ">=0.80.0",
    "livekit-client": "^2.20.0"
  },
  "peerDependenciesMeta": {
    "livekit-client": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iveri/contracts": "^0.98.0",
    "@iveri/eslint-config": "^0.2.3",
    "@iveri/prettier-config": "^0.1.0",
    "@iveri/react-kit": "^0.13.1",
    "@iveri/tsconfig": "^0.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "livekit-client": "^2.24.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4",
    "rimraf": "^6.1.4",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
